# Nombre visible de la API.
APP_NAME=Parqueadero API

# Entorno de ejecución (por ejemplo: development, test o production).
APP_ENV=development

# URL de conexión de SQLAlchemy; usa el servicio db al ejecutar en Compose.
DATABASE_URL=postgresql+psycopg://parqueadero:parqueadero_dev@db:5432/parqueadero

# Inicio local del día operativo y límites exclusivos de las franjas.
OPERATING_DAY_START=06:00
DAYTIME_START=06:00
DAYTIME_END=18:00
NIGHTTIME_START=18:00
NIGHTTIME_END=06:00

# Zona horaria usada por las reglas del día operativo.
OPERATING_TIMEZONE=America/Bogota

# Umbral de confianza LPR entre 0 y 1; su uso se incorpora en HU-12.
LPR_CONFIDENCE_THRESHOLD=0.8

# Nombre de la base de datos que inicializa el contenedor PostgreSQL.
POSTGRES_DB=parqueadero

# Usuario de desarrollo que inicializa el contenedor PostgreSQL.
POSTGRES_USER=parqueadero

# Contraseña de ejemplo SOLO para desarrollo local; reemplázala fuera de local.
POSTGRES_PASSWORD=parqueadero_dev
